# ─── Ligne de commande ───────────────────────────────────────────────────────────────────
# ID (ou lien) de la playlist exportée par défaut : le nombre dans l'URL de la playlist,
# ex. https://www.deezer.com/fr/playlist/908622995
DEEZER_PLAYLIST_ID=908622995

# Playlists privées (facultatif, l'un OU l'autre) :
# - cookie « arl » de deezer.com (voir README, « Playlists privées ») ;
# - jeton OAuth d'une application Deezer existante.
DEEZER_ARL=
DEEZER_ACCESS_TOKEN=

# ─── Site web ────────────────────────────────────────────────────────────────────────────
# URL publique du site : sert aux cookies Secure (https) et à l'URL de retour OAuth.
PUBLIC_URL=https://deezer.eliott-roussille.fr

# Connexion OAuth : seulement avec une application Deezer existante (Deezer n'en accepte
# plus de nouvelles). URL de retour à déclarer : $PUBLIC_URL/connexion/deezer/retour
DEEZER_APP_ID=
DEEZER_APP_SECRET=

# Connexion par cookie « arl » (true/false).
ARL_LOGIN=true

# Durée d'inactivité avant expiration d'une session (minutes).
SESSION_TTL_MINUTES=60
# Exports simultanés, et exports en cours ou en attente au plus.
EXPORT_WORKERS=2
MAX_PENDING_JOBS=8

# Statistiques de visite (Rybbit), facultatif : les deux, ou aucun.
ANALYTICS_SCRIPT=
ANALYTICS_SITE_ID=
